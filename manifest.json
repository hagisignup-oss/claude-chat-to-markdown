{
  "manifest_version": 3,
  "name": "Claude Chat to Markdown",
  "version": "0.1.0",
  "description": "claude.aiの会話をMarkdown形式でダウンロードする拡張機能（MVP）",
  "action": {
    "default_popup": "popup.html",
    "default_title": "会話をMarkdownで保存"
  },
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
